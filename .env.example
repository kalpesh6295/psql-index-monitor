# The database to analyze. This is the only way to connect — there is no
# connect-from-the-browser by design, so credentials never pass through the
# client. Without it the app starts disconnected. Restart after changing.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Required to run the Index Doctor agent (from the UI or `npm run agent`).
ANTHROPIC_API_KEY=

# Server ports (defaults shown).
# PORT=4201
# API_PORT=4200

# Agent options.
# AGENT_MODEL=claude-opus-5
# QUERY_CATALOG_DIR=/path/to/your/apps/sql-queries   # lets the agent check rare/scheduled queries before drop advice

# CLI-only: target for `npm run agent` / `npm run baseline` etc. The eval
# sandbox created by eval/sandbox/setup.sh lives at:
# SANDBOX_DATABASE_URL=postgres://postgres:postgres@localhost:5499/indexdoctor
